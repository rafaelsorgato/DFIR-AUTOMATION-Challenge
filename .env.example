# Copy this file to .env and adjust the values for your environment.
# cp .env.example .env

# Ollama LLM server
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=25
OLLAMA_RATE_LIMIT_PER_MINUTE=200

# LLM retry behaviour
MAX_RETRIES=3

# Database
# Docker Compose overrides this to sqlite:////app/data/alerts.db (volume path)
DATABASE_URL=sqlite:///alerts.db
